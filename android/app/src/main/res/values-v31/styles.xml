<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31) splash screen -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Full-screen background color -->
        <item name="android:windowSplashScreenBackground">#153A2B</item>
        <!-- White logo icon; icon background matches splash bg so the circle is invisible -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_image</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#153A2B</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
